<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>MiniCraft · Bedrock</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;margin:0;padding:0;}
html,body{width:100%;height:100%;overflow:hidden;background:#000;color:#fff;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:14px;}
#c{display:block;width:100%;height:100%;touch-action:none;}
.screen{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;}
.screen.on{display:flex;}
.panel{width:min(440px,94vw);max-height:92vh;overflow-y:auto;padding:16px;background:#1d1d1d;border:2px solid #3c3c3c;border-radius:4px;box-shadow:0 10px 40px rgba(0,0,0,.85);}
.panel::-webkit-scrollbar{width:6px;}
.panel::-webkit-scrollbar-thumb{background:#4c4c4c;border-radius:3px;}
.title{font-size:19px;font-weight:700;text-align:center;letter-spacing:2px;color:#fff;text-shadow:2px 2px 0 #000;margin-bottom:14px;}
.btn{display:block;width:100%;padding:11px 12px;margin-bottom:8px;cursor:pointer;background:#4c4c4c;border:2px solid #6a6a6a;border-radius:3px;color:#fff;font-size:14.5px;font-weight:600;text-align:center;letter-spacing:1px;box-shadow:inset 0 2px 0 rgba(255,255,255,.12),0 3px 0 #2a2a2a;transition:transform .05s;font-family:inherit;}
.btn:active{transform:translateY(2px);box-shadow:inset 0 2px 0 rgba(255,255,255,.12),0 1px 0 #2a2a2a;}
.btn.primary{background:#3c8527;border-color:#5aad3c;box-shadow:inset 0 2px 0 rgba(255,255,255,.18),0 3px 0 #245018;}
.btn.primary:active{box-shadow:inset 0 2px 0 rgba(255,255,255,.18),0 1px 0 #245018;}
.btn.danger{background:#8b2f2f;border-color:#b04040;box-shadow:inset 0 2px 0 rgba(255,255,255,.12),0 3px 0 #4a1818;}
.srow{display:flex;justify-content:space-between;align-items:center;padding:8px 2px;font-size:13.5px;color:#d4d4d4;border-bottom:1px solid #2a2a2a;}
.srow:last-child{border-bottom:none;}
.sval{color:#7fd45a;font-weight:700;font-family:ui-monospace,monospace;font-size:13px;}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:22px;background:transparent;margin:4px 0;}
input[type=range]::-webkit-slider-runnable-track{height:6px;border-radius:3px;background:#3a3a3a;border:1px solid #555;}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:3px;background:#c6c6c6;border:2px solid #8a8a8a;margin-top:-8px;box-shadow:0 2px 0 #555;cursor:pointer;}
input[type=range]::-moz-range-track{height:6px;border-radius:3px;background:#3a3a3a;border:1px solid #555;}
input[type=range]::-moz-range-thumb{width:14px;height:14px;border-radius:3px;background:#c6c6c6;border:2px solid #8a8a8a;cursor:pointer;}
.textInput{width:100%;padding:9px 10px;margin:6px 0 10px;background:#0e0e0e;border:2px solid #3a3a3a;border-radius:3px;color:#fff;font-size:14px;font-family:inherit;outline:none;}
.textInput:focus{border-color:#5aad3c;}
.toggle{display:flex;border:2px solid #555;border-radius:3px;overflow:hidden;cursor:pointer;}
.toggle .opt{padding:5px 12px;font-size:12.5px;font-weight:700;background:#2e2e2e;color:#888;transition:background .12s,color .12s;min-width:52px;text-align:center;}
.toggle .opt.on{background:#3c8527;color:#fff;text-shadow:1px 1px 0 rgba(0,0,0,.5);}
#menu{background:linear-gradient(to bottom,#5b8fbd 0%,#8ab8d8 32%,#c8d8e4 58%,#a8b898 78%,#7a8a60 100%);overflow:hidden;}
#menu::before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 15% 22%,rgba(255,255,255,.55) 0%,transparent 8%),radial-gradient(circle at 42% 14%,rgba(255,255,255,.45) 0%,transparent 6%),radial-gradient(circle at 72% 25%,rgba(255,255,255,.5) 0%,transparent 7%),radial-gradient(circle at 88% 12%,rgba(255,255,255,.4) 0%,transparent 5%);animation:cloudDrift 90s linear infinite;}
@keyframes cloudDrift{from{transform:translateX(-3%);}to{transform:translateX(3%);}}
#menu::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(to bottom,transparent 65%,rgba(0,0,0,.35) 100%);}
#menuInner{position:relative;z-index:2;width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;}
#menuLogo{text-align:center;margin-bottom:26px;}
#menuLogo h1{font-size:clamp(34px,9vw,54px);font-weight:900;letter-spacing:6px;color:#fff;text-shadow:4px 4px 0 #1a3a08,5px 5px 0 rgba(0,0,0,.4);line-height:1;}
#menuLogo p{font-size:11px;letter-spacing:5px;color:#e8f0d8;margin-top:6px;text-shadow:2px 2px 0 rgba(0,0,0,.5);}
#menuBtnBox{width:min(320px,86vw);}
.mbtn{display:block;width:100%;padding:13px;margin-bottom:9px;cursor:pointer;background:linear-gradient(to bottom,#8a8a8a,#6e6e6e);border:2px solid #2a2a2a;border-radius:2px;color:#fff;font-size:15px;font-weight:700;letter-spacing:2px;font-family:inherit;box-shadow:inset 0 2px 0 rgba(255,255,255,.28),inset 0 -3px 0 rgba(0,0,0,.28),0 3px 0 rgba(0,0,0,.5);text-shadow:2px 2px 0 rgba(0,0,0,.55);transition:transform .06s,filter .06s;}
.mbtn:hover{filter:brightness(1.1);}
.mbtn:active{transform:translateY(3px);box-shadow:inset 0 2px 0 rgba(255,255,255,.28),inset 0 -3px 0 rgba(0,0,0,.28),0 0 0 rgba(0,0,0,.5);}
#menuFooter{position:absolute;bottom:12px;left:0;right:0;text-align:center;font-size:11px;color:rgba(255,255,255,.85);text-shadow:1px 1px 0 rgba(0,0,0,.6);letter-spacing:1.5px;z-index:2;}
.worldItem{display:flex;gap:10px;padding:8px;margin-bottom:8px;background:#262626;border:2px solid #3a3a3a;border-radius:3px;cursor:pointer;transition:border-color .1s;}
.worldItem:hover{border-color:#5aad3c;}
.worldItem img{width:64px;height:36px;object-fit:cover;border-radius:2px;background:#111;border:1px solid #444;image-rendering:pixelated;}
.worldItem .info{flex:1;min-width:0;}
.worldItem .nm{font-size:13.5px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.worldItem .meta{font-size:10.5px;color:#888;font-family:ui-monospace,monospace;margin-top:3px;}
.worldItem .acts{display:flex;gap:4px;margin-top:5px;}
.tinyBtn{padding:3px 8px;background:#3a3a3a;border:1px solid #555;border-radius:2px;color:#ccc;font-size:10.5px;cursor:pointer;font-family:inherit;}
.tinyBtn:hover{background:#4a4a4a;color:#fff;}
.empty{text-align:center;color:#666;padding:24px 0;font-size:13px;}
#loading{background:#0e1218;flex-direction:column;}
#loading .wrap{text-align:center;animation:zoomIn .5s cubic-bezier(.34,1.4,.64,1);}
@keyframes zoomIn{from{transform:scale(.7);opacity:0;}to{transform:scale(1);opacity:1;}}
#loading .logo{font-size:28px;font-weight:900;letter-spacing:5px;color:#7fd45a;text-shadow:3px 3px 0 #24451a;margin-bottom:4px;}
#loading .sub{font-size:10px;letter-spacing:3px;color:#6a7a8a;margin-bottom:22px;}
#loadBar{width:min(280px,72vw);height:10px;background:#1e242c;border:2px solid #333;border-radius:2px;overflow:hidden;margin:0 auto;}
#loadFill{height:100%;width:0%;background:linear-gradient(90deg,#3c8527,#7fd45a);transition:width .15s;}
#loadTxt{font-size:11px;color:#7a8a9a;margin-top:10px;font-family:ui-monospace,monospace;}
#hud{position:fixed;inset:0;pointer-events:none;z-index:10;display:none;}
#cross{position:absolute;left:50%;top:50%;width:20px;height:20px;margin:-10px 0 0 -10px;opacity:.78;}
#cross::before,#cross::after{content:"";position:absolute;background:#fff;box-shadow:0 0 3px rgba(0,0,0,.95);}
#cross::before{left:50%;top:0;width:2px;height:100%;margin-left:-1px;}
#cross::after{top:50%;left:0;height:2px;width:100%;margin-top:-1px;}
#info{position:absolute;left:8px;top:6px;color:#fff;font-size:10.5px;line-height:1.6;text-shadow:1px 1px 0 rgba(0,0,0,.95),-1px -1px 0 rgba(0,0,0,.95),0 0 6px rgba(0,0,0,.9);white-space:pre;font-family:ui-monospace,Menlo,monospace;}
.gbtn{position:absolute;pointer-events:auto;border-radius:50%;background:rgba(0,0,0,.35);border:2px solid rgba(255,255,255,.5);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;text-shadow:0 1px 3px rgba(0,0,0,.9);touch-action:none;font-size:15px;transition:transform .06s,background .06s;}
.gbtn:active{transform:scale(.9);background:rgba(255,255,255,.35);}
#btnJump{right:84px;bottom:20px;width:58px;height:58px;}
#btnBreak{right:16px;bottom:20px;width:68px;height:68px;font-size:16px;border-color:rgba(255,150,130,.85);background:rgba(140,40,30,.45);}
#btnPlace{right:16px;bottom:94px;width:58px;height:58px;border-color:rgba(150,225,150,.85);background:rgba(50,120,55,.45);}
#btnPause{right:14px;top:12px;width:40px;height:40px;font-size:16px;border-radius:6px;}
#btnChat{right:14px;top:58px;width:40px;height:40px;font-size:17px;border-radius:6px;}
#hotbar{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);display:flex;gap:4px;padding:4px 5px;background:rgba(0,0,0,.4);border-radius:4px;}
.slot{pointer-events:auto;width:38px;height:38px;border:2px solid rgba(255,255,255,.35);border-radius:3px;background:rgba(30,30,30,.7);display:flex;align-items:center;justify-content:center;transition:transform .08s,border-color .08s;overflow:hidden;}
.slot.sel{border-color:#fff;background:rgba(255,255,255,.25);transform:translateY(-4px);}
.slot img{width:26px;height:26px;image-rendering:pixelated;}
#joy{position:absolute;pointer-events:none;width:110px;height:110px;border-radius:50%;border:2px solid rgba(255,255,255,.22);background:rgba(255,255,255,.06);display:none;}
#joyKnob{position:absolute;left:50%;top:50%;width:46px;height:46px;margin:-23px 0 0 -23px;border-radius:50%;background:rgba(255,255,255,.32);border:2px solid rgba(255,255,255,.55);}
#tip{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#fff;font-size:13px;text-shadow:0 2px 8px #000;text-align:center;line-height:1.9;pointer-events:none;}
#chatLog{position:absolute;left:8px;bottom:120px;max-width:280px;max-height:140px;overflow:hidden;font-size:12px;line-height:1.7;text-shadow:1px 1px 0 #000;color:#fff;pointer-events:none;}
.chatLine{background:rgba(0,0,0,.45);padding:2px 6px;border-radius:2px;margin-bottom:2px;display:inline-block;}
#chatBox{position:absolute;left:50%;bottom:120px;transform:translateX(-50%);pointer-events:auto;width:min(280px,70vw);display:none;}
#chatInput{width:100%;padding:8px 10px;background:rgba(0,0,0,.75);color:#fff;border:2px solid #5aad3c;border-radius:3px;font-size:13px;font-family:inherit;outline:none;}
#players{position:absolute;right:10px;top:100px;font-size:11px;color:#fff;text-shadow:1px 1px 0 rgba(0,0,0,.9);font-family:ui-monospace,monospace;text-align:right;line-height:1.6;}
.codeBox{font-family:ui-monospace,monospace;font-size:28px;font-weight:900;letter-spacing:6px;color:#7fd45a;text-align:center;padding:14px;background:#0e0e0e;border:2px dashed #3c8527;border-radius:4px;margin:8px 0;}
@media (max-width:620px){
.slot{width:32px;height:32px;}
.slot img{width:22px;height:22px;}
#hotbar{bottom:74px;gap:3px;padding:3px 4px;}
#btnBreak{width:62px;height:62px;right:12px;bottom:12px;font-size:14px;}
#btnPlace{width:52px;height:52px;right:12px;bottom:82px;}
#btnJump{width:52px;height:52px;right:80px;bottom:12px;}
#info{font-size:9.5px;}
.panel{padding:12px;}
}
</style>
</head>
<body>
<canvas id="c"></canvas>

<div id="menu" class="screen on">
  <div id="menuInner">
    <div id="menuLogo">
      <h1>MINICRAFT</h1>
      <p>BEDROCK EDITION</p>
    </div>
    <div id="menuBtnBox">
      <button class="mbtn" id="btnNewWorld">创 建 新 世 界</button>
      <button class="mbtn" id="btnMulti">多 人 游 戏</button>
      <button class="mbtn" id="btnLoadWorld">存 档 列 表</button>
      <button class="mbtn" id="btnSettings">设 置</button>
    </div>
  </div>
  <div id="menuFooter">v2.0 · WebGL · Bedrock Style</div>
</div>

<div id="dlgNew" class="screen">
  <div class="panel">
    <div class="title">创建新世界</div>
    <div class="srow"><span>世界名称</span></div>
    <input type="text" id="nwName" class="textInput" maxlength="24" placeholder="新的世界">
    <div class="srow"><span>种子</span><span class="sval" id="nwSeedInfo">随机</span></div>
    <input type="text" id="nwSeed" class="textInput" placeholder="留空则使用随机种子">
    <div class="srow"><span>最大内存</span><span class="sval" id="nwRamInfo">2048 MB</span></div>
    <input type="range" id="nwRam" min="512" max="8192" step="256" value="2048">
    <div class="srow"><span>渲染距离</span><span class="sval" id="nwDistInfo">6 区块</span></div>
    <input type="range" id="nwDist" min="2" max="16" step="1" value="6">
    <div style="height:12px"></div>
    <button class="btn primary" id="btnDoCreate">创 建 世 界</button>
    <button class="btn" id="btnCancelNew">取 消</button>
  </div>
</div>

<div id="dlgMulti" class="screen">
  <div class="panel">
    <div class="title">多人游戏</div>
    <div class="srow"><span>玩家名称</span></div>
    <input type="text" id="mmName" class="textInput" maxlength="16" placeholder="玩家">
    <button class="btn primary" id="btnHost">创 建 房 间</button>
    <div class="srow"><span>加入房间</span></div>
    <input type="text" id="mmCode" class="textInput" maxlength="6" placeholder="6 位房间代码" style="text-transform:uppercase;letter-spacing:3px;text-align:center;font-size:18px;">
    <button class="btn primary" id="btnJoin">加 入 房 间</button><div id="roomList" style="margin:10px 0 4px;max-height:180px;overflow-y:auto;font-size:12px;border:1px solid #333;border-radius:3px;padding:6px;background:#151515;color:#888;">加载房间列表…</div>
    <button class="btn" id="btnBackMulti">返 回</button>
    <div id="mmStatus" style="text-align:center;font-size:12px;color:#8a94a6;margin-top:8px;min-height:18px;"></div>
  </div>
</div>

<div id="dlgRoom" class="screen">
  <div class="panel">
    <div class="title">房间已创建</div>
    <div style="text-align:center;font-size:12px;color:#888;margin-bottom:4px;">把下面的代码发给朋友</div>
    <div class="codeBox" id="roomCode">------</div>
    <div style="text-align:center;font-size:12px;color:#8a94a6;margin-bottom:14px;" id="roomStatus">等待玩家加入…</div>
    <div id="roomPlayers" style="margin-bottom:14px;"></div>
    <button class="btn primary" id="btnRoomStart">开 始 游 戏</button>
    <button class="btn danger" id="btnRoomClose">关 闭 房 间</button>
  </div>
</div>

<div id="dlgList" class="screen">
  <div class="panel">
    <div class="title">存档列表</div>
    <div id="worldListContent"></div>
    <div style="height:8px"></div>
    <button class="btn" id="btnImport">导 入 .wmp 文 件</button>
    <button class="btn primary" id="btnBackList">返 回 主 菜 单</button>
    <input type="file" id="fileImport" accept=".wmp,.zip" style="display:none">
  </div>
</div>

<div id="dlgSettings" class="screen">
  <div class="panel">
    <div class="title">设置</div>
    <div class="srow"><span>树叶透明</span>
      <div class="toggle" id="tgLeaves"><div class="opt" data-v="0">关</div><div class="opt on" data-v="1">开</div></div>
    </div>
    <div class="srow"><span>视角灵敏度</span><span class="sval" id="stSensVal">1.0×</span></div>
    <input type="range" id="stSens" min="30" max="300" step="10" value="100">
    <div class="srow"><span>视野 FOV</span><span class="sval" id="stFovVal">70°</span></div>
    <input type="range" id="stFov" min="50" max="110" step="5" value="70">
    <div class="srow"><span>性能模式</span>
      <div class="toggle" id="tgPerf"><div class="opt" data-v="0">画质</div><div class="opt on" data-v="1">平衡</div><div class="opt" data-v="2">性能</div></div>
    </div>
    <div style="height:10px"></div>
    <button class="btn primary" id="btnSettingsOk">完 成</button>
  </div>
</div>

<div id="loading" class="screen">
  <div class="wrap">
    <div class="logo">MINICRAFT</div>
    <div class="sub">BUILDING WORLD</div>
    <div id="loadBar"><div id="loadFill"></div></div>
    <div id="loadTxt">0%</div>
  </div>
</div>

<div id="hud">
  <div id="cross"></div>
  <div id="info"></div>
  <div id="players"></div>
  <div id="chatLog"></div>
  <div id="chatBox"><input type="text" id="chatInput" maxlength="80" placeholder="按 Enter 发送…"></div>
  <div id="joy"><div id="joyKnob"></div></div>
  <div id="hotbar"></div>
  <div id="btnJump" class="gbtn">跳</div><div id="btnDescend" class="gbtn" style="display:none;right:84px;bottom:20px;width:58px;height:58px;">下</div>
  <div id="btnBreak" class="gbtn">挖</div>
  <div id="btnPlace" class="gbtn">放</div>
  <div id="btnChat" class="gbtn">💬</div>
  <div id="btnPause" class="gbtn">☰</div>
  <div id="tip"></div>
</div>

<div id="pause" class="screen">
  <div class="panel">
    <div class="title">游戏菜单</div>
    <button class="btn primary" id="btnResume">返 回 游 戏</button>
    <button class="btn" id="btnSave">保 存 世 界</button>
    <button class="btn" id="btnExport">导 出 为 .wmp</button>
    <button class="btn" id="btnPauseSettings">设 置</button>
    <button class="btn danger" id="btnQuit">保 存 并 退 出</button>
  </div>
</div>

<script>
(function(){
"use strict";
function $(id){ return document.getElementById(id); }
function setCookie(n,v,d){var e=new Date();e.setTime(e.getTime()+d*864e5);document.cookie=n+'='+encodeURIComponent(v)+';expires='+e.toUTCString()+';path=/';}
function getCookie(n){var m=document.cookie.match(new RegExp('(?:^|; )'+n+'=([^;]*)'));return m?decodeURIComponent(m[1]):null;}
function clamp(v,a,b){return v<a?a:(v>b?b:v);}
function fmtTime(t){var d=new Date(t);var p=function(n){return n<10?'0'+n:''+n;};return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+' '+p(d.getHours())+':'+p(d.getMinutes());}
function randSeed(){if(window.crypto&&crypto.getRandomValues){var a=new Uint32Array(1);crypto.getRandomValues(a);return a[0]%2147483647;}return (Math.random()*2147483647)|0;}

/* ===== CRC32 / Base64 / RLE ===== */
var CRC_T=null;
function crcTable(){if(CRC_T)return CRC_T;var t=new Uint32Array(256);for(var n=0;n<256;n++){var c=n;for(var k=0;k<8;k++)c=(c&1)?(0xEDB88320^(c>>>1)):(c>>>1);t[n]=c>>>0;}return CRC_T=t;}
function crc32(buf){var t=crcTable(),c=0xFFFFFFFF;for(var i=0;i<buf.length;i++)c=t[(c^buf[i])&0xFF]^(c>>>8);return (c^0xFFFFFFFF)>>>0;}
function b64enc(bytes){var bin='',CH=0x8000;for(var i=0;i<bytes.length;i+=CH){bin+=String.fromCharCode.apply(null,bytes.subarray(i,Math.min(i+CH,bytes.length)));}return btoa(bin);}
function b64dec(s){var bin=atob(s);var a=new Uint8Array(bin.length);for(var i=0;i<bin.length;i++)a[i]=bin.charCodeAt(i);return a;}
function rleEnc(data){var out=new Uint8Array(data.length*3);var p=0,i=0,n=data.length;while(i<n){var v=data[i],c=1;while(i+c<n&&data[i+c]===v&&c<65535)c++;out[p++]=c&0xFF;out[p++]=(c>>8)&0xFF;out[p++]=v;i+=c;}return out.subarray(0,p);}
function rleDec(buf,size){var out=new Uint8Array(size);var p=0,i=0;while(i<buf.length&&p<size){var c=buf[i]|(buf[i+1]<<8);var v=buf[i+2];i+=3;for(var k=0;k<c&&p<size;k++)out[p++]=v;}return out;}

/* ===== ZIP ===== */
function zipCreate(files){var parts=[],central=[],offset=0;var enc=new TextEncoder();for(var i=0;i<files.length;i++){var f=files[i];var nb=enc.encode(f.name);var crc=crc32(f.data);var sz=f.data.length;var local=new Uint8Array(30+nb.length);var dv=new DataView(local.buffer);dv.setUint32(0,0x04034b50,true);dv.setUint16(4,20,true);dv.setUint16(6,0,true);dv.setUint16(8,0,true);dv.setUint16(10,0,true);dv.setUint16(12,0x2100,true);dv.setUint32(14,crc,true);dv.setUint32(18,sz,true);dv.setUint32(22,sz,true);dv.setUint16(26,nb.length,true);dv.setUint16(28,0,true);local.set(nb,30);parts.push(local,f.data);var cent=new Uint8Array(46+nb.length);var dc=new DataView(cent.buffer);dc.setUint32(0,0x02014b50,true);dc.setUint16(4,20,true);dc.setUint16(6,20,true);dc.setUint16(8,0,true);dc.setUint16(10,0,true);dc.setUint16(12,0,true);dc.setUint16(14,0x2100,true);dc.setUint32(16,crc,true);dc.setUint32(20,sz,true);dc.setUint32(24,sz,true);dc.setUint16(28,nb.length,true);dc.setUint16(30,0,true);dc.setUint16(32,0,true);dc.setUint16(34,0,true);dc.setUint16(36,0,true);dc.setUint32(38,0,true);dc.setUint32(42,offset,true);cent.set(nb,46);central.push(cent);offset+=local.length+sz;}var cs=0;for(var j=0;j<central.length;j++)cs+=central[j].length;var eocd=new Uint8Array(22);var de=new DataView(eocd.buffer);de.setUint32(0,0x06054b50,true);de.setUint16(4,0,true);de.setUint16(6,0,true);de.setUint16(8,files.length,true);de.setUint16(10,files.length,true);de.setUint32(12,cs,true);de.setUint32(16,offset,true);de.setUint16(20,0,true);var total=offset+cs+22;var out=new Uint8Array(total);var pos=0;for(var k=0;k<parts.length;k++){out.set(parts[k],pos);pos+=parts[k].length;}for(var m=0;m<central.length;m++){out.set(central[m],pos);pos+=central[m].length;}out.set(eocd,pos);return out;}
function zipRead(bytes){var dv=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength);var eocd=-1;for(var i=bytes.length-22;i>=0;i--){if(dv.getUint32(i,true)===0x06054b50){eocd=i;break;}}if(eocd<0)throw new Error('不是有效的 ZIP 文件');var count=dv.getUint16(eocd+10,true);var cdOff=dv.getUint32(eocd+16,true);var dec=new TextDecoder();var out=[],pos=cdOff;for(var n=0;n<count;n++){if(dv.getUint32(pos,true)!==0x02014b50)break;var method=dv.getUint16(pos+10,true);var compSz=dv.getUint32(pos+20,true);var nl=dv.getUint16(pos+28,true);var el=dv.getUint16(pos+30,true);var cl=dv.getUint16(pos+32,true);var lo=dv.getUint32(pos+42,true);var name=dec.decode(bytes.subarray(pos+46,pos+46+nl));var lnl=dv.getUint16(lo+26,true);var lel=dv.getUint16(lo+28,true);var ds=lo+30+lnl+lel;var data=bytes.subarray(ds,ds+compSz);out.push({name:name,method:method,data:data});pos+=46+nl+el+cl;}return out;}
async function inflateRaw(data){if(typeof DecompressionStream==='undefined')throw new Error('浏览器不支持解压');var ds=new DecompressionStream('deflate-raw');var blob=new Blob([data]);var stream=blob.stream().pipeThrough(ds);var ab=await new Response(stream).arrayBuffer();return new Uint8Array(ab);}

/* ===== 方块注册 ===== */
var AIR=0,STONE=1,GRASS=2,DIRT=3,COBBLE=4,PLANKS=5,LOG=6,LEAVES=7,SAND=8,WATER=9,BEDROCK=10,GLASS=11,BRICK=12,SNOW=13;
var B=[];
function def(id,name,tt,ts,tb,o){o=o||{};B[id]={id:id,name:name,tTop:tt,tSide:ts,tBot:tb,opaque:o.opaque!==undefined?o.opaque:true,solid:o.solid!==undefined?o.solid:true,gravity:o.gravity?true:false};}
def(AIR,'air',null,null,null,{opaque:false,solid:false});
def(STONE,'stone','stone','stone','stone');
def(GRASS,'grass_block','grass_top','grass_side','dirt');
def(DIRT,'dirt','dirt','dirt','dirt');
def(COBBLE,'cobblestone','cobble','cobble','cobble');
def(PLANKS,'oak_planks','planks','planks','planks');
def(LOG,'oak_log','log_top','log_side','log_top');
def(LEAVES,'oak_leaves','leaves','leaves','leaves',{opaque:false,solid:true});
def(SAND,'sand','sand','sand','sand',{gravity:true});
def(WATER,'water','water','water','water',{opaque:false,solid:false});
def(BEDROCK,'bedrock','bedrock','bedrock','bedrock');
def(GLASS,'glass','glass','glass','glass',{opaque:false,solid:true});
def(BRICK,'bricks','brick','brick','brick');
def(SNOW,'snow_block','snow','snow','snow');

/* ===== SVG 纹理（与原版一致） ===== */
function svg(inner){return 'data:image/svg+xml;charset=utf-8,'+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" shape-rendering="crispEdges">'+inner+'</svg>');}
